{
  "name": "company.md",
  "version": "0.4.0",
  "description": "An open, agent-readable company context standard for enterprise AI workspaces.",
  "homepage": "https://github.com/dilanhendadura/company.md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dilanhendadura/company.md.git"
  },
  "bugs": {
    "url": "https://github.com/dilanhendadura/company.md/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "company.md": "./dist/cli.js",
    "companymd": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./linter": {
      "types": "./dist/lint.d.ts",
      "import": "./dist/lint.js"
    }
  },
  "files": [
    "dist",
    ".agents/skills/company",
    "templates",
    "schemas",
    "docs",
    "assets/company-md-hero.svg",
    "integrations",
    "examples/northstar",
    "evals",
    "SPEC.md",
    "GOVERNANCE.md",
    "ROADMAP.md",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run check:example && npm run check:plugin",
    "check:example": "node dist/cli.js lint examples/northstar",
    "check:plugin": "node scripts/sync-plugin-skill.mjs --check && node scripts/validate-distribution.mjs",
    "dev": "tsx src/cli.ts",
    "prepare": "npm run build",
    "sync:plugin": "node scripts/sync-plugin-skill.mjs",
    "test": "npm run build && tsx --test test/*.test.ts",
    "test:coverage": "npm run build && node --import tsx --test --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-lines=80 --test-coverage-branches=65 --test-coverage-functions=85 test/*.test.ts",
    "test:package": "node scripts/smoke-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google/design.md": "0.4.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "ai",
    "agents",
    "company-context",
    "enterprise-ai",
    "markdown"
  ],
  "publishConfig": {
    "access": "public"
  }
}
