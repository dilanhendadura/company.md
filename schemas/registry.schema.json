{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company.md/schemas/0.1/registry.schema.json",
  "title": "Company.md subject registry v1",
  "type": "object",
  "required": ["schema", "subjects"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "companymd/registry/v1" },
    "subjects": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "pack"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["group", "company", "product", "brand"] },
          "parent": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "pack": { "type": "string", "minLength": 1 },
          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "object", "minProperties": 1, "additionalProperties": false,
              "properties": {
                "design": { "type": "string", "minLength": 1 },
                "template": { "type": "string", "minLength": 1 },
                "templateSkill": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
